<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Task Details | TenantFlow</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body data-protected="true"
  class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white min-h-screen flex flex-col"
>
<script>window.__USER__ = <%- JSON.stringify(locals.__user__ || null) %>;</script>


<!-- NAVBAR -->
<nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-4">

    <div class="flex items-center gap-3">
      <img src="/assets/Logo.png" class="h-8" />
      <span class="text-lg font-semibold hidden sm:inline">TenantFlow</span>
    </div>

    <button id="navToggle" aria-expanded="false" class="md:hidden p-2 text-slate-400 hover:text-white transition" aria-label="Toggle navigation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <div id="navMenu" class="hidden md:flex absolute md:static top-16 left-0 right-0 md:flex-row flex-col items-center gap-4 md:gap-6 text-sm text-slate-400 bg-slate-900 md:bg-transparent px-6 py-4 md:py-0 border-b md:border-0 border-slate-800 z-50">
      <a href="/dashboard" class="hover:text-white transition w-full md:w-auto text-center md:text-left">Dashboard</a>
      <a href="/projects" class="hover:text-white transition w-full md:w-auto text-center md:text-left">Projects</a>
      <a href="/workspace/members" class="hover:text-white transition w-full md:w-auto text-center md:text-left">Members</a>
      <button id="logoutBtn" class="hover:text-white transition w-full md:w-auto text-center md:text-left">Logout</button>
    </div>

  </div>
</nav>



<!-- MAIN -->
<main class="flex-1 flex justify-center px-4 sm:px-6 py-8 sm:py-12">

  <div class="w-full max-w-xl bg-slate-800/60 border border-slate-700 rounded-2xl sm:rounded-3xl p-6 sm:p-10">

    <!-- HEADER -->
    <div class="mb-8 text-center">
      <h1 class="text-2xl sm:text-3xl font-bold">Task Details</h1>
      <p class="text-slate-400 text-sm mt-2">
        View or update task information
      </p>
    </div>


    <form id="taskDetailForm" class="space-y-6">
      <input type="hidden" id="taskId" value="" />
      <input type="hidden" id="projectId" value="" />


      <!-- TITLE -->
      <div>
        <label class="block text-sm text-slate-300 mb-2">Task Title</label>

        <input
          type="text"
          id="title"
          value="<%= task?.title || '' %>"
          required
          class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm"
        />
      </div>


      <!-- DESCRIPTION -->
      <div>
        <label class="block text-sm text-slate-300 mb-2">Description</label>

        <textarea
          id="description"
          rows="4"
          class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm"
        ><%= task?.description || '' %></textarea>
      </div>


      <!-- STATUS -->
      <div>
        <label class="block text-sm text-slate-300 mb-2">Status</label>

        <select id="status"
          class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm"
        >
          <option value="todo" <%= task?.status === "todo" ? "selected" : "" %>>Todo</option>
          <option value="in_progress" <%= task?.status === "in_progress" ? "selected" : "" %>>In Progress</option>
          <option value="completed" <%= task?.status === "completed" ? "selected" : "" %>>Completed</option>
        </select>
      </div>


      <!-- ASSIGN -->
      <div>
        <label class="block text-sm text-slate-300 mb-2">Assign Member</label>

        <select id="assignedTo"
          class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm"
        >
          <option value="">Unassigned</option>
        </select>
      </div>


      <!-- DATE -->
      <div>
        <label class="block text-sm text-slate-300 mb-2">Due Date</label>

        <input
          type="date"
          id="dueDate"
          value="<%= task?.dueDate || '' %>"
          class="w-full bg-slate-900 border border-slate-700 rounded-xl p-3 text-sm"
        />
      </div>


      <!-- BUTTONS -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">

        <!-- UPDATE -->
        <button
          type="submit"
          id="updateBtn"
          class="w-full sm:flex-1 bg-blue-600 hover:bg-blue-700 py-3 rounded-xl text-sm"
        >
          Update Task
        </button>

        <button
          type="button"
          id="deleteBtn"
          class="w-full sm:flex-1 bg-red-600 hover:bg-red-700 py-3 rounded-xl text-sm"
        >
          Delete
        </button>

      </div>


      <!-- BACK -->
      <a
        href="/projects/<%= task?.projectId %>"
        class="block text-center mt-4 bg-slate-700 hover:bg-slate-600 py-3 rounded-xl text-sm"
      >
        Back to Project
      </a>

    </form>

  </div>

</main>



<footer class="border-t border-slate-800 py-6 text-center text-sm text-slate-500">
  © <%= new Date().getFullYear() %> TenantFlow
</footer>


<script>
  window.TASK_ID = "<%= locals.taskId || '' %>";
</script>
<script src="/js/api.js"></script>
<script src="/js/auth.js"></script>
<script src="/js/tasks.js"></script>
<script src="/js/navbar.js"></script>

</body>
</html>