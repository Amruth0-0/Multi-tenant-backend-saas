<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Workspace Members | TenantFlow</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    @keyframes fadeInUp { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
    .fade-in { animation: fadeInUp 0.35s ease forwards; }
  </style>
</head>
<body data-protected="true" class="bg-[#0a0f1e] text-white min-h-screen flex flex-col">
<script>window.__USER__ = <%- JSON.stringify(locals.__user__ || null) %>;</script>

<!-- NAVBAR -->
<nav class="border-b border-slate-800/60 bg-[#0d1424]/80 backdrop-blur-xl sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6 py-3">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-violet-600 rounded-lg flex items-center justify-center text-sm font-bold shrink-0">T</div>
      <span class="text-base font-semibold hidden sm:inline">TenantFlow</span>
    </div>

    <button id="navToggle" aria-expanded="false" class="md:hidden p-2 text-slate-400 hover:text-white transition" aria-label="Toggle navigation">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <div id="navMenu" class="hidden md:flex absolute md:static top-12 left-0 right-0 md:flex-row flex-col items-stretch md:items-center gap-1 text-sm text-slate-400 bg-[#0d1424] md:bg-transparent px-4 sm:px-6 py-3 md:py-0 border-b md:border-0 border-slate-800/60 z-50">
      <a href="/dashboard" class="px-3 py-2 md:py-1.5 rounded-md hover:bg-slate-800 hover:text-white transition text-xs text-center md:text-left">Dashboard</a>
      <a href="/projects" class="px-3 py-2 md:py-1.5 rounded-md hover:bg-slate-800 hover:text-white transition text-xs text-center md:text-left">Projects</a>
      <a href="/workspace/members" class="px-3 py-2 md:py-1.5 rounded-md bg-slate-800 text-white text-xs font-medium text-center md:text-left">Members</a>
      <button id="logoutBtn" class="px-3 py-2 md:py-1.5 rounded-md hover:bg-red-900/40 hover:text-red-400 transition text-xs text-center md:text-left mt-1 md:mt-0 md:ml-2">Logout</button>
    </div>
  </div>
</nav>

<main class="flex-1 px-4 sm:px-6 py-6 sm:py-8 max-w-5xl mx-auto w-full">

  <!-- HEADER -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 fade-in">
    <div>
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight">Team Members</h1>
      <p class="text-slate-400 text-sm mt-1">Manage roles and invite new people to your workspace.</p>
    </div>
  </div>

  <!-- INVITE BANNER -->
  <div id="inviteBanner" class="mb-6 fade-in bg-gradient-to-br from-violet-900/30 to-blue-900/30 border border-violet-500/20 rounded-2xl p-5">
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h2 class="text-sm font-semibold mb-1">🔗 Invite your team</h2>
        <p class="text-xs text-slate-400">Anyone with this link can join this workspace as a member instantly.</p>
      </div>
      <button id="resetLinkBtn" class="text-xs text-slate-500 hover:text-red-400 transition shrink-0">↺ Reset link</button>
    </div>
    <div class="flex items-center gap-2 bg-slate-900/60 rounded-xl px-4 py-2.5 border border-slate-700/50 mt-3">
      <span id="inviteLinkDisplay" class="text-xs text-slate-300 truncate flex-1 font-mono">Loading…</span>
      <button id="copyLinkBtn" class="text-xs text-blue-400 hover:text-blue-300 transition font-medium shrink-0 px-2 py-1 rounded-md hover:bg-blue-900/30">Copy</button>
    </div>
  </div>

  <!-- MEMBERS TABLE -->
  <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl overflow-x-auto fade-in responsive-table-wrap">
    <div class="sm:hidden p-4 text-center text-xs text-slate-500">← Swipe to see more →</div>
    <table class="w-full text-sm min-w-[500px]">
      <thead class="border-b border-slate-700/60 text-slate-400">
        <tr>
          <th class="text-left px-5 py-3 whitespace-nowrap">Member</th>
          <th class="text-left px-5 py-3 whitespace-nowrap">Email</th>
          <th class="text-center px-4 py-3 whitespace-nowrap">Role</th>
          <th class="text-center px-4 py-3 whitespace-nowrap">Actions</th>
        </tr>
      </thead>
      <tbody id="memberTableBody">
        <tr><td colspan="4" class="text-center py-12 text-slate-500">Loading members…</td></tr>
      </tbody>
    </table>
  </div>

</main>

<footer class="border-t border-slate-800/60 py-5 text-center text-xs text-slate-600 mt-8">
  © <%= new Date().getFullYear() %> TenantFlow
</footer>

<script src="/js/api.js?v=2"></script>
<script src="/js/auth.js"></script>
<script src="/js/members.js?v=2"></script>
<script src="/js/navbar.js"></script>
</body>
</html>