<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <title>Dashboard | TenantFlow</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body data-protected="true"
  class="bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-white min-h-screen flex flex-col"
>

<!-- NAVBAR -->
<nav class="border-b border-slate-800 bg-slate-900/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">

    <!-- Logo -->
    <div class="flex items-center gap-3">
      <img src="/assets/Logo.png" alt="TenantFlow Logo" class="h-8 w-auto object-contain" />
      <span class="text-lg font-semibold tracking-wide">TenantFlow</span>
    </div>

    <!-- Navigation -->
    <div class="flex items-center gap-6 text-sm text-slate-400">

      <a href="/dashboard" class="hover:text-white transition">Dashboard</a>

      <a href="/projects" class="hover:text-white transition">Projects</a>

      <a href="/workspace/members" class="hover:text-white transition">Members</a>

      <button
        id="logoutBtn"
        class="hover:text-white transition text-sm text-slate-400"
      >
        Logout
      </button>

    </div>
  </div>
</nav>


<!-- MAIN -->
<main class="flex-1 px-6 py-10 max-w-7xl mx-auto w-full">

  <!-- HEADER -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold">Dashboard</h1>
    <p class="text-slate-400 text-sm mt-1">
      Welcome back! Here's your workspace overview.
    </p>
  </div>


  <!-- STATS -->
  <div class="grid md:grid-cols-4 gap-6 mb-10">

    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">
      <p class="text-sm text-slate-400">Workspace</p>
      <h2 id="workspaceNameEl" class="text-xl font-semibold mt-2">Loading...</h2>
    </div>

    <!-- Projects -->
    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">
      <p class="text-sm text-slate-400">Projects</p>
      <h2 id="projectCountEl" class="text-2xl font-bold mt-2">—</h2>
    </div>

    <!-- Tasks -->
    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">
      <p class="text-sm text-slate-400">Tasks</p>
      <h2 id="taskCountEl" class="text-2xl font-bold mt-2">—</h2>
    </div>

    <!-- Members -->
    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">
      <p class="text-sm text-slate-400">Members</p>
      <h2 id="memberCountEl" class="text-2xl font-bold mt-2">—</h2>
    </div>

  </div>


  <!-- QUICK ACTIONS -->
  <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6 mb-10">

    <h2 class="text-lg font-semibold mb-4">Quick Actions</h2>

    <div class="flex flex-wrap gap-3">

      <a href="/projects/create"
        class="bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg text-sm transition">
        + Create Project
      </a>

      <a href="/workspace/members/invite"
        class="border border-slate-600 hover:border-slate-400 px-4 py-2 rounded-lg text-sm transition">
        Invite Member
      </a>

      <a href="/projects"
        class="border border-slate-600 hover:border-slate-400 px-4 py-2 rounded-lg text-sm transition">
        View Projects
      </a>

    </div>
  </div>


  <!-- WIDGETS -->
  <div class="grid md:grid-cols-2 gap-6 mb-10">

    <!-- RECENT PROJECTS -->
    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">

      <h2 class="text-lg font-semibold mb-4">Recent Projects</h2>

      <div id="recentProjectList" class="space-y-3 text-sm">
        <p class="text-slate-400 italic">Loading...</p>
      </div>
    </div>


    <!-- MEMBERS -->
    <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">

      <h2 class="text-lg font-semibold mb-4">Workspace Members</h2>

      <div id="memberListWidget" class="space-y-3 text-sm">
        <p class="text-slate-400 italic">Loading...</p>
      </div>
    </div>

  </div>


  <!-- GETTING STARTED -->
  <div class="bg-slate-800/60 border border-slate-700 rounded-2xl p-6">
    <h2 class="text-lg font-semibold mb-4">⚡ Getting Started</h2>
    <div class="space-y-3 text-sm">

      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 hover:bg-slate-900 transition cursor-pointer" onclick="window.location.href='/projects/create'">
        <span class="text-2xl">📁</span>
        <div>
          <div class="font-medium">Create your first project</div>
          <div class="text-slate-400 text-xs">Organise your work into projects and track progress</div>
        </div>
        <span class="ml-auto text-blue-400 text-xs">→</span>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 hover:bg-slate-900 transition cursor-pointer" onclick="window.location.href='/workspace/members/invite'">
        <span class="text-2xl">👥</span>
        <div>
          <div class="font-medium">Invite your team</div>
          <div class="text-slate-400 text-xs">Bring collaborators into your workspace</div>
        </div>
        <span class="ml-auto text-blue-400 text-xs">→</span>
      </div>

      <div class="flex items-center gap-3 p-3 rounded-xl bg-slate-900/60 hover:bg-slate-900 transition cursor-pointer" onclick="window.location.href='/projects'">
        <span class="text-2xl">✅</span>
        <div>
          <div class="font-medium">Manage tasks</div>
          <div class="text-slate-400 text-xs">Break projects into actionable tasks with deadlines</div>
        </div>
        <span class="ml-auto text-blue-400 text-xs">→</span>
      </div>

    </div>
  </div>

</main>


<!-- FOOTER -->
<footer class="border-t border-slate-800 py-6 text-center text-sm text-slate-500">
  © <%= new Date().getFullYear() %> TenantFlow. All Rights Reserved.
</footer>

<script src="/js/api.js?v=2"></script>
<script src="/js/auth.js"></script>
<script src="/js/dashboard.js"></script>

</body>
</html>