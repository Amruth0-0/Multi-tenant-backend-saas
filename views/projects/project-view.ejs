<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Project | TenantFlow</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .progress-bar { transition: width 0.7s cubic-bezier(0.4,0,0.2,1); }
    .kanban-col { min-height: 120px; }
    .task-card { cursor: grab; transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .task-card:active { cursor: grabbing; }
    .task-card.sortable-ghost { opacity: 0.3; }
    .task-card.sortable-drag { transform: rotate(2deg); box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
    .col-dropping { background: rgba(99,102,241,0.06); border-color: rgba(99,102,241,0.4) !important; }
    .view-btn.active { background: #1e293b; color: white; border-color: #475569; }
    @keyframes slideIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
    .fade-in { animation: slideIn 0.3s ease forwards; }
  </style>
</head>
<body data-protected="true" class="bg-[#0a0f1e] text-white min-h-screen flex flex-col">

<!-- NAVBAR -->
<nav class="border-b border-slate-800/60 bg-[#0d1424]/80 backdrop-blur-xl sticky top-0 z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 py-3">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-violet-600 rounded-lg flex items-center justify-center text-sm font-bold">T</div>
      <span class="text-base font-semibold">TenantFlow</span>
    </div>
    <div class="flex items-center gap-1 text-sm text-slate-400">
      <a href="/dashboard" class="px-3 py-1.5 rounded-md hover:bg-slate-800 hover:text-white transition text-xs">Dashboard</a>
      <a href="/projects" class="px-3 py-1.5 rounded-md bg-slate-800 text-white text-xs font-medium">Projects</a>
      <a href="/workspace/members" class="px-3 py-1.5 rounded-md hover:bg-slate-800 hover:text-white transition text-xs">Members</a>
      <button id="logoutBtn" class="px-3 py-1.5 rounded-md hover:bg-red-900/40 hover:text-red-400 transition text-xs ml-2">Logout</button>
    </div>
  </div>
</nav>

<main class="flex-1 px-6 py-8 max-w-7xl mx-auto w-full">

  <!-- HEADER -->
  <div class="mb-6 fade-in">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs text-slate-500 mb-1"><a href="/projects" class="hover:text-slate-300 transition">← All Projects</a></p>
        <h1 id="projectNameEl" class="text-2xl font-bold tracking-tight">Loading…</h1>
        <p id="projectDescEl" class="text-slate-400 text-sm mt-1"></p>
      </div>
      <a id="createTaskLink" href="/tasks/create"
        class="shrink-0 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl text-sm font-medium transition flex items-center gap-2">
        <span>＋</span> Add Task
      </a>
    </div>

    <!-- PROGRESS BAR -->
    <div class="mt-5">
      <div class="flex justify-between text-xs text-slate-500 mb-1.5">
        <span>Project Progress</span>
        <span id="progressLabel">0 / 0 tasks completed</span>
      </div>
      <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
        <div id="progressBar" class="progress-bar h-2 rounded-full bg-gradient-to-r from-blue-500 to-violet-500" style="width:0%"></div>
      </div>
    </div>
  </div>

  <!-- VIEW TOGGLE -->
  <div class="flex items-center gap-2 mb-6">
    <button id="boardBtn" class="view-btn active px-4 py-1.5 rounded-lg text-sm border border-slate-700 text-slate-400 transition">⬛ Board</button>
    <button id="listBtn"  class="view-btn px-4 py-1.5 rounded-lg text-sm border border-slate-700 text-slate-400 transition">☰ List</button>
  </div>


  <!-- ═══════════════ BOARD VIEW (Kanban) ═══════════════ -->
  <div id="boardView">
    <div class="grid md:grid-cols-3 gap-5">

      <!-- TODO -->
      <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl p-4">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-slate-400"></span>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-slate-400">To Do</h2>
          <span id="countTodo" class="ml-auto text-xs bg-slate-700 text-slate-300 px-2 py-0.5 rounded-full">0</span>
        </div>
        <div id="boardTodo" class="kanban-col space-y-3" data-status="todo"></div>
      </div>

      <!-- IN PROGRESS -->
      <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl p-4">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-yellow-400">In Progress</h2>
          <span id="countProgress" class="ml-auto text-xs bg-yellow-900/50 text-yellow-300 px-2 py-0.5 rounded-full">0</span>
        </div>
        <div id="boardProgress" class="kanban-col space-y-3" data-status="in_progress"></div>
      </div>

      <!-- DONE -->
      <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl p-4">
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <h2 class="text-xs font-semibold uppercase tracking-widest text-emerald-400">Done</h2>
          <span id="countDone" class="ml-auto text-xs bg-emerald-900/50 text-emerald-300 px-2 py-0.5 rounded-full">0</span>
        </div>
        <div id="boardDone" class="kanban-col space-y-3" data-status="completed"></div>
      </div>

    </div>
  </div>


  <!-- ═══════════════ LIST VIEW ═══════════════ -->
  <div id="taskListView" class="hidden">
    <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-700/60 text-slate-400">
          <tr>
            <th class="text-left px-5 py-3">Task</th>
            <th class="text-left px-5 py-3">Assignee</th>
            <th class="text-center px-4 py-3">Status</th>
            <th class="text-center px-4 py-3">Due</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody id="taskList">
          <tr><td colspan="5" class="text-center py-12 text-slate-500">Loading tasks…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

</main>

<footer class="border-t border-slate-800/60 py-5 text-center text-xs text-slate-600 mt-8">
  © <%= new Date().getFullYear() %> TenantFlow
</footer>

<!-- SortableJS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script>
  window.PROJECT_ID = "<%= locals.projectId || '' %>";
</script>
<script src="/js/api.js?v=2"></script>
<script src="/js/auth.js"></script>
<script src="/js/tasks.js?v=2"></script>

</body>
</html>